rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'seojuyung@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function validLocalized(value) {
      return value is map
        && value.keys().hasOnly(['en', 'ko'])
        && value.en is string
        && value.ko is string
        && value.en.size() <= 12000
        && value.ko.size() <= 12000;
    }

    function validPressText(value) {
      return validLocalized(value) && value.en.size() > 0 && value.ko.size() > 0;
    }

    function validPressUrl(value) {
      return value is string && value.size() <= 2048
        && value.matches('https?://[^\\s]+');
    }

    function validPressCard(card) {
      return card is map
        && card.keys().hasOnly(['id', 'kind', 'meta', 'title', 'image', 'imageAlt', 'url'])
        && card.id is string && card.id.matches('[a-zA-Z0-9_-]{1,80}')
        && card.kind in ['linkedin', 'book', 'video', 'article']
        && validPressText(card.meta) && validPressText(card.title) && validPressText(card.imageAlt)
        && card.image is string && card.image.size() <= 2048
        && (card.image == '' || validPressUrl(card.image) || card.image.matches('/[a-zA-Z0-9_][a-zA-Z0-9_./-]*'))
        && validPressUrl(card.url);
    }

    function validPressIntroduction(data) {
      return data.keys().hasOnly(['id', 'eyebrow', 'title', 'body', 'cardIds'])
        && data.id == 'main'
        && validPressText(data.eyebrow) && validPressText(data.title) && validPressText(data.body)
        && data.cardIds is list && data.cardIds.size() <= 12
        && data.cardIds.toSet().size() == data.cardIds.size()
        && (data.cardIds.size() <= 0 || (data.cardIds[0] is string && data.cardIds[0] != 'main' && data.cardIds[0].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 1 || (data.cardIds[1] is string && data.cardIds[1] != 'main' && data.cardIds[1].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 2 || (data.cardIds[2] is string && data.cardIds[2] != 'main' && data.cardIds[2].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 3 || (data.cardIds[3] is string && data.cardIds[3] != 'main' && data.cardIds[3].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 4 || (data.cardIds[4] is string && data.cardIds[4] != 'main' && data.cardIds[4].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 5 || (data.cardIds[5] is string && data.cardIds[5] != 'main' && data.cardIds[5].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 6 || (data.cardIds[6] is string && data.cardIds[6] != 'main' && data.cardIds[6].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 7 || (data.cardIds[7] is string && data.cardIds[7] != 'main' && data.cardIds[7].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 8 || (data.cardIds[8] is string && data.cardIds[8] != 'main' && data.cardIds[8].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 9 || (data.cardIds[9] is string && data.cardIds[9] != 'main' && data.cardIds[9].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 10 || (data.cardIds[10] is string && data.cardIds[10] != 'main' && data.cardIds[10].matches('[a-zA-Z0-9_-]{1,80}')))
        && (data.cardIds.size() <= 11 || (data.cardIds[11] is string && data.cardIds[11] != 'main' && data.cardIds[11].matches('[a-zA-Z0-9_-]{1,80}')))
        ;
    }

    function validFocusText(text) {
      return validLocalized(text) && text.en.size() > 0 && text.ko.size() > 0
        && text.en.size() <= 120 && text.ko.size() <= 120;
    }

    function validFocus(focus) {
      return focus is map && focus.keys().hasOnly(['label', 'items'])
        && validFocusText(focus.label) && focus.items is list && focus.items.size() <= 6
        && (focus.items.size() <= 0 || validFocusText(focus.items[0]))
        && (focus.items.size() <= 1 || validFocusText(focus.items[1]))
        && (focus.items.size() <= 2 || validFocusText(focus.items[2]))
        && (focus.items.size() <= 3 || validFocusText(focus.items[3]))
        && (focus.items.size() <= 4 || validFocusText(focus.items[4]))
        && (focus.items.size() <= 5 || validFocusText(focus.items[5]))
        ;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'id', 'name', 'title', 'headline', 'summary', 'contactEmail',
          'location', 'avatarUrl', 'socialLinks', 'focus', 'updatedAt'
        ])
        && data.id == 'main'
        && (!('focus' in data) || validFocus(data.focus))
        && validLocalized(data.name)
        && validLocalized(data.title)
        && validLocalized(data.headline)
        && validLocalized(data.summary)
        && validLocalized(data.location)
        && data.contactEmail is string
        && data.contactEmail.size() <= 320
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048
        && data.socialLinks is list
        && data.socialLinks.size() <= 12
        && data.updatedAt is string;
    }

    function validEntryImage(url) {
      return url is string && url.size() <= 2048
        && (url == '' || url.matches('https?://[^\\s]+') || url.matches('/[a-zA-Z0-9_][a-zA-Z0-9_./-]*'));
    }

    function validEntryLink(link) {
      return link is map && link.keys().hasOnly(['id', 'label', 'url'])
        && link.id is string && link.id.size() <= 160
        && validLocalized(link.label) && validPressUrl(link.url);
    }

    function validEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['id', 'title', 'description', 'imageUrl', 'images', 'tags', 'links'])
        && entry.id is string && entry.id.matches('[a-zA-Z0-9_-]{1,160}')
        && validPressText(entry.title) && validLocalized(entry.description)
        && validEntryImage(entry.imageUrl)
        && (!('tags' in entry) || (entry.tags is list && entry.tags.size() <= 12 && !entry.tags.hasAny([''])
          && entry.tags.join('').matches('[a-zA-Z0-9_-]*')
          && entry.tags.join(',').matches('([a-zA-Z0-9_-]{1,80}(,[a-zA-Z0-9_-]{1,80})*)?')))
        && (!('images' in entry) || (entry.images is list && entry.images.size() <= 6
          && (entry.images.size() <= 0 || (entry.images[0] != '' && validEntryImage(entry.images[0])))
          && (entry.images.size() <= 1 || (entry.images[1] != '' && validEntryImage(entry.images[1])))
          && (entry.images.size() <= 2 || (entry.images[2] != '' && validEntryImage(entry.images[2])))
          && (entry.images.size() <= 3 || (entry.images[3] != '' && validEntryImage(entry.images[3])))
          && (entry.images.size() <= 4 || (entry.images[4] != '' && validEntryImage(entry.images[4])))
          && (entry.images.size() <= 5 || (entry.images[5] != '' && validEntryImage(entry.images[5])))))
        && entry.links is list && entry.links.size() <= 3
        && (entry.links.size() <= 0 || validEntryLink(entry.links[0]))
        && (entry.links.size() <= 1 || validEntryLink(entry.links[1]))
        && (entry.links.size() <= 2 || validEntryLink(entry.links[2]));
    }

    function validTimeline(data, id) {
      return data.keys().hasOnly([
          'id', 'title', 'role', 'organization', 'period', 'location',
          'description', 'links', 'highlights', 'entryIds', 'tags', 'section', 'imageUrl', 'images', 'featured',
          'order', 'updatedAt'
        ])
        && data.id == id
        && validLocalized(data.title)
        && validLocalized(data.role)
        && validLocalized(data.organization)
        && validLocalized(data.location)
        && validLocalized(data.description)
        && data.period is string
        && data.period.size() <= 120
        && data.links is list
        && data.links.size() <= 12
        && (!('highlights' in data)
          || (data.highlights is list && data.highlights.size() <= 40))
        && (!('entryIds' in data) || (data.entryIds is list && data.entryIds.size() <= 40
          && data.entryIds.join('').size() <= 12800 && data.entryIds.join('').matches('[a-zA-Z0-9_-]*') && data.highlights.size() == 0))
        && data.tags is list
        && data.tags.size() <= 12
        && data.section is string
        && data.section.size() <= 80
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048
        && (!('images' in data) || (data.images is list && data.images.size() <= 6
          && (data.images.size() <= 0 || (data.images[0] != '' && validEntryImage(data.images[0])))
          && (data.images.size() <= 1 || (data.images[1] != '' && validEntryImage(data.images[1])))
          && (data.images.size() <= 2 || (data.images[2] != '' && validEntryImage(data.images[2])))
          && (data.images.size() <= 3 || (data.images[3] != '' && validEntryImage(data.images[3])))
          && (data.images.size() <= 4 || (data.images[4] != '' && validEntryImage(data.images[4])))
          && (data.images.size() <= 5 || (data.images[5] != '' && validEntryImage(data.images[5])))))
        && data.featured is bool
        && data.order is int
        && data.order >= 0
        && data.order <= 100000
        && data.updatedAt is string;
    }

    function validSection(data, id) {
      return data.keys().hasOnly(['id', 'title', 'eyebrow', 'order', 'visible', 'updatedAt'])
        && data.id == id
        && validLocalized(data.title)
        && validLocalized(data.eyebrow)
        && data.order is int
        && data.order >= 0
        && data.order <= 10000
        && data.visible is bool
        && data.updatedAt is string;
    }

    function validLabel(data, id) {
      return data.keys().hasOnly(['id', 'name', 'accent', 'order', 'updatedAt'])
        && data.id == id
        && validLocalized(data.name)
        && data.accent is string
        && data.accent.matches('^#[0-9a-fA-F]{6}$')
        && data.order is int
        && data.order >= 0
        && data.order <= 10000
        && data.updatedAt is string;
    }

    match /press/{pressId} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        (pressId == 'main' && validPressIntroduction(request.resource.data))
        || (pressId != 'main' && request.resource.data.id == pressId && validPressCard(request.resource.data))
      );
      allow delete: if isAdmin() && pressId != 'main';
    }

    match /profile/{profileId} {
      allow read: if true;
      allow create, update: if profileId == 'main' && isAdmin() && validProfile(request.resource.data);
      allow delete: if false;
    }

    match /talkEntries/{entryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'yearId', 'entry'])
        && request.resource.data.id == entryId
        && request.resource.data.yearId is string
        && request.resource.data.yearId.matches('[a-zA-Z0-9_-]{1,160}')
        && entryId == request.resource.data.yearId + '--' + request.resource.data.entry.id
        && validEntry(request.resource.data.entry);
      allow delete: if isAdmin();
    }

    match /timeline/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validTimeline(request.resource.data, itemId);
      allow delete: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow create, update: if isAdmin() && validSection(request.resource.data, sectionId);
      allow delete: if isAdmin();
    }

    match /labels/{labelId} {
      allow read: if true;
      allow create, update: if isAdmin() && validLabel(request.resource.data, labelId);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
